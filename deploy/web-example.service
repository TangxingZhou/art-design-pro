[Unit]
Description=Web Example
After=network-online.target remote-fs.target nss-lookup.target
Wants=network-online.target
ConditionFileIsExecutable=/usr/sbin/nginx

[Service]
Type=forking
PIDFile=/run/nginx.pid
WorkingDirectory=/home/ubuntu/services/art-design-pro
ExecStartPre=/usr/sbin/nginx -t -q -g 'daemon on; master_process on;'
ExecStart=/usr/sbin/nginx -g 'daemon on; master_process on;'  -c deploy/nginx.conf
ExecReload=/usr/sbin/nginx -g 'daemon on; master_process on;' -s reload  -c deploy/nginx.conf
ExecStop=-/sbin/start-stop-daemon --quiet --stop --retry QUIT/5 --pidfile /run/nginx.pid  -c deploy/nginx.conf
TimeoutStopSec=5
KillMode=mixed

[Install]
WantedBy=multi-user.target